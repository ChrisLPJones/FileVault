<?xml version="1.0" encoding="utf-8"?>
<!-- Used by `dotnet test` for this project (see RunSettingsFilePath in Backend.Test.csproj).
     The tests create their own FvTest_ database and point every host at it (see TestAdmins.cs). -->
<RunSettings>
  <RunConfiguration>
    <EnvironmentVariables>
      <!-- No caching of per-user access-token state, so tests see deletions and password changes at once -->
      <Auth__UserStateCacheSeconds>0</Auth__UserStateCacheSeconds>
      <!-- Test hosts don't run the cleanup loop on their own; tests call RunOnceAsync when they need it -->
      <Storage__BackgroundCleanup>false</Storage__BackgroundCleanup>
      <!-- The real disk's fill level (default cap 80%) must not fail unrelated upload tests; the disk-limit tests use fake figures -->
      <Storage__MaxDiskUsePercent>0</Storage__MaxDiskUsePercent>
    </EnvironmentVariables>
  </RunConfiguration>
  <!-- Do NOT add <xUnit><MaxParallelThreads>: xunit.runner.visualstudio honours it and it overrides the
       [assembly: CollectionBehavior(MaxParallelThreads = -1)] in TestParallelism.cs, which turns the
       sync context back on (see the comment there). Verified 2026-10-15 -->
</RunSettings>
