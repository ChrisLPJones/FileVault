# Settings for deploy/backup.sh and deploy/restore.sh. Copy to ~/filevault/backup.env on the server
# and run chmod 600 on it. This file holds secrets: never commit the real one, never put it in
# the backup, and keep it apart from .env (the scripts never read .env).

# Where the backups go (restic repository). Backblaze B2: b2:<bucket-name>:<folder>
# A local directory (/path/on/this/machine) also works, e.g. for testing.
RESTIC_REPOSITORY=b2:your-bucket-name:filevault

# File holding the restic repository password (its own chmod 600 file, not in this env file).
#   (umask 077; openssl rand -base64 32 > ~/filevault/restic-password)
# Keep a copy in your password manager: without it the backups cannot be opened.
RESTIC_PASSWORD_FILE=/home/deploy/filevault/restic-password

# Backblaze B2 application key limited to that one bucket (not the master key). Leave both out
# for a local directory repository.
B2_ACCOUNT_ID=
B2_ACCOUNT_KEY=

# Optional: healthchecks.io ping URL of the check (https://hc-ping.com/<uuid>). Without it no alerts
# are sent. The script pings /start, then success, or /fail with the last log lines.
HC_PING_URL=

# Optional overrides
# COMPOSE_PROJECT=filevault        # Docker Compose project name of the stack
# FV_STATE_DIR=/home/deploy/filevault   # log, lock file (default: the folder of this file)
# RESTIC_IMAGE=restic/restic@sha256:8f5a62b422a2cb1277ea0dd6e826fe1acf649e5b9f02d60e5268d5fd1976255a  (pinned by digest)
