# Secrets for the full stack in docker-compose.yml.
# Copy to .env (gitignored) and fill in every value.

# SQL Server "sa" password: at least 8 characters with upper, lower, digit and symbol.
# Avoid ";" (it breaks the connection string) and "$" (compose treats it as a variable).
# SQL Server only applies this when the sql_data volume is first created.
MSSQL_SA_PASSWORD=change-me-Str0ng!

# JWT signing key, at least 32 bytes:  openssl rand -base64 48
JWT_KEY=

# File encryption master key, base64 of exactly 32 bytes:  openssl rand -base64 32
# BACK THIS UP. Stored files cannot be decrypted without it.
ENCRYPTION_MASTER_KEY=

# Only while rotating the master key (docs/DEPLOYMENT.md, "Rotating the master key"): the new key,
# base64 of 32 bytes. After the rotation, move it to ENCRYPTION_MASTER_KEY and delete this line.
# ENCRYPTION_MASTER_KEY_NEW=

# Optional but recommended on any public install: the email address that becomes the first
# administrator, once it is confirmed. Without it, the first account registered becomes the
# administrator, so anyone who gets there before you would be one. After registering, open the
# confirmation email, then choose your password with "Forgot password" (see docs/DEPLOYMENT.md).
INITIAL_ADMIN_EMAIL=

# Optional: where the browser reaches the frontend and the API
# (defaults: http://localhost:5173 and http://localhost:3000)
# FRONTEND_URL=http://localhost:5173
# API_URL=http://localhost:3000

# Optional: SMTP server for password reset and email confirmation emails.
# Without SMTP_HOST the API writes those emails (with their links) to its log instead.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=FileVault <no-reply@example.com>

# Optional: serve the interactive API docs at <API_URL>/swagger (off by default)
# SWAGGER_ENABLED=true

# Optional: set when the app is served over HTTPS through a reverse proxy. The API then trusts
# the proxy's X-Forwarded-For/-Proto headers and always marks the refresh cookie Secure.
# Only do this if the API port isn't reachable except through the proxy (see docs/DEPLOYMENT.md).
# BEHIND_HTTPS_PROXY=true

# Optional: show each user's last login country on the admin page. Create a free MaxMind account,
# generate a licence key, fill these in, then run:  docker compose --profile geoip up -d
# The database is downloaded to the geoip_data volume; no address is ever sent to MaxMind.
GEOIPUPDATE_ACCOUNT_ID=
GEOIPUPDATE_LICENSE_KEY=

# Optional: "hosted" for a public instance where accounts unused for 30 days are removed (after a
# warning email, when SMTP is set up) and users see a first-login notice. Leave empty or
# "self-hosted" for a normal install. Anything else stops the API starting.
FILEVAULT_MODE=
# Hosted mode only: the address the notice tells users to email to ask for a permanent account.
# Leave empty to leave that sentence out.
HOSTED_CONTACT_EMAIL=

# Optional: where to report abuse. Shown as "Report abuse: <address>" on the sign-in, sign-up and
# share pages and in Settings. Must be a plain email address (otherwise the API won't start).
# Empty: nothing is shown, except that hosted mode uses HOSTED_CONTACT_EMAIL.
ABUSE_CONTACT_EMAIL=

# Uploads are refused when they would take the drive holding the storage volume past this percent
# full (1-99), so a full disk can't take the server down. 0 turns the limit off. Empty means 80.
# Applies in both modes, to every account. See docs/DEPLOYMENT.md.
STORAGE_MAX_DISK_USE_PERCENT=
