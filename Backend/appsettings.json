{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Cors": {
    "AllowedOrigins": [ "http://localhost:5173" ]
  },
  "ConnectionStrings": {
    "DefaultConnection": ""
  },
  "StorageRoot": "SecureVaultStorage",
  "Storage": {
    "DefaultQuotaBytes": 1073741824,
    "MaxUploadBytes": 104857600,
    "TrashRetentionDays": 30,
    "MaxFileBytes": 10737418240,
    "CreateDefaultFolders": true,
    "DefaultFolders": [ "Documents", "Pictures", "Music", "Videos" ]
  },
  "Jwt": {
    "Key": "",
    "Issuer": "app_Issuer",
    "Audience": "app_Audience",
    "ExpireMinutes": 15,
    "RefreshDays": 7,
    "RefreshReuseGraceSeconds": 30
  },
  "RateLimiting": {
    "auth": { "PermitLimit": 10, "WindowSeconds": 60 },
    "refresh": { "PermitLimit": 30, "WindowSeconds": 60 }
  },
  "Encryption": {
    "MasterKey": ""
  },
  "App": {
    "FrontendUrl": ""
  },
  "Email": {
    "Smtp": {
      "Host": "",
      "Port": 587,
      "User": "",
      "Password": "",
      "From": "",
      "EnableSsl": true
    }
  }
}
