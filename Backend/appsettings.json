{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Cors": {
    "AllowedOrigins": [ "http://localhost:5173" ]
  },
  "ConnectionStrings": {
    "DefaultConnection": ""
  },
  "StorageRoot": "SecureVaultStorage",
  "Jwt": {
    "Key": "",
    "Issuer": "app_Issuer",
    "Audience": "app_Audience",
    "ExpireMinutes": 15,
    "RefreshDays": 7,
    "RefreshReuseGraceSeconds": 30
  },
  "RateLimiting": {
    "auth": { "PermitLimit": 10, "WindowSeconds": 60 },
    "refresh": { "PermitLimit": 30, "WindowSeconds": 60 }
  },
  "Encryption": {
    "MasterKey": ""
  }
}
